  "annotations": [
    { "id": "note-c-settled", "x": 0, "y": -195, "w": 400, "page": "page-1", "text": "Settled 30 Aug: direction C (poster school), red pieces — Black plays in red, White in cream, heavy black outlines, black-outline last-move markers. Review is Anki-style: principle flip-cards graded Again/Hard/Good/Easy, positions grade themselves." },
    { "id": "note-journal", "x": 0, "y": -195, "w": 400, "page": "page-3", "text": "OTB journal — a diary, not an analysis tool: no engine, no evaluations, no ratings anywhere. The W/L/D strip is a descriptive tally of the player's own entries. \"Study: Philidor\" on the viewer links the game to a trainer lesson." },
    { "id": "note-direction-a", "x": 0, "y": -200, "w": 380, "page": "page-2", "text": "A · Study hall — warm paper, serif headings, wooden board. Feels like working through a good endgame book.\nTradeoff: the calmest option, but the least distinctive at a glance." },
    { "id": "note-direction-b", "x": 1060, "y": -200, "w": 380, "page": "page-2", "text": "B · Tournament — dark UI, vinyl-green board, mono numerals, segmented progress. Focused, session-like, easy on the eyes at night.\nTradeoff: reads gamified; less of the study-book calm." },
    { "id": "note-direction-d", "x": 2120, "y": -200, "w": 380, "page": "page-2", "text": "D · Quiet board — near-monochrome, hairlines, one blue accent, board with no frame. Nothing competes with the position.\nTradeoff: restraint depends on flawless spacing; can feel plain." }
  ],
